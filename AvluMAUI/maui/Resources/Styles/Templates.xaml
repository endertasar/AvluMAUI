<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Avlu · Shared Control Templates
  Tasarımda kullanılan özel kontrollerin şablonları:
    - AvluEntryTemplate    : label + prefix + entry (telefon / şifre)
    - AvluButtonStyle      : primary / secondary / ghost
    - AvluLogomark         : SVG'nin XAML Path karşılığı
    - AvluBackButton       : üst sol geri butonu (kare + ok)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <!-- Primary button (lacivert → beyaz) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Accent}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=White, Dark={StaticResource NavyDeep}}" />
        <Setter Property="CharacterSpacing" Value="-0.1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.88" />
                            <Setter Property="Scale" Value="0.985" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary button (outline) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Ghost button (ör. "Girişe Dön") -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Input "kart" (52 yükseklik, 14 radius, ince kenar, focus'ta navy/accent) -->
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha04}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource WhiteAlpha12}}" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="14" />
        </Setter>
    </Style>

    <!-- Entry (içerideki asıl text input) -->
    <Style x:Key="FieldEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- OTP kutusu (6 hane, tek karakter, büyük tipografi) -->
    <Style x:Key="OtpEntry" TargetType="Entry">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Keyboard" Value="Numeric" />
        <Setter Property="MaxLength" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha04}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- OTP kutusu (48×58, 12 radius) -->
    <Style x:Key="OtpBox" TargetType="Border">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha04}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource WhiteAlpha12}}" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>

    <!-- OTP Entry (kutu içi) -->
    <Style x:Key="OtpEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="MaxLength" Value="1" />
        <Setter Property="Keyboard" Value="Numeric" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Avlu logomark (SVG Path → XAML Path) — 48×48 viewbox -->
    <ControlTemplate x:Key="AvluLogomark">
        <Grid WidthRequest="48" HeightRequest="48">
            <!-- Dış çerçeve -->
            <shapes:Rectangle Stroke="{TemplateBinding BindingContext}"
                              StrokeThickness="2.5"
                              Fill="Transparent"
                              WidthRequest="42" HeightRequest="42"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              RadiusX="11" RadiusY="11" />
            <!-- İç kemer -->
            <shapes:Path Stroke="{StaticResource Accent}"
                         StrokeThickness="2.5"
                         StrokeLineCap="Round"
                         Data="M 16 34 V 24 A 8 8 0 0 1 32 24 V 34" />
            <!-- Taban -->
            <shapes:Line X1="14" Y1="34" X2="34" Y2="34"
                         Stroke="{TemplateBinding BindingContext}"
                         StrokeThickness="2.5"
                         StrokeLineCap="Round" />
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
