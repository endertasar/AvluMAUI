<?xml version="1.0" encoding="utf-8" ?>
<!-- AdminApp · CollectSuccessPage — Makbuz özeti -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Avlu.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Avlu.AdminApp.Views.CollectSuccessPage"
             Title="Başarılı"
             Shell.BackButtonBehavior="{x:Null}">
    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,28" Spacing="20">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,10,0,0">
                <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E3F2E9, Dark=#282E7D57}">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="999" /></Border.StrokeShape>
                    <Label Text="✓" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Success}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Tahsilat Alındı" FontFamily="{StaticResource FontInterSemi}" FontSize="20" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                <Label Text="Makbuz otomatik oluşturuldu." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Padding="16" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11"><Label Text="Mülk" Style="{StaticResource Caption}" /><Label Grid.Column="1" Text="A Blok · D12" FontFamily="{StaticResource FontInterSemi}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11"><Label Text="Dönem" Style="{StaticResource Caption}" /><Label Grid.Column="1" Text="2026 Temmuz Aidatı" FontFamily="{StaticResource FontInterSemi}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11"><Label Text="Tutar" Style="{StaticResource Caption}" /><Label Grid.Column="1" Text="1.250,00 ₺" FontFamily="{StaticResource FontInterSemi}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11"><Label Text="Kalan Borç" Style="{StaticResource Caption}" /><Label Grid.Column="1" Text="0,00 ₺" FontFamily="{StaticResource FontInterSemi}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" /></Grid>
                    <controls:StatusPill StatusValue="Odendi" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Button Text="Yeni Tahsilat" Style="{StaticResource PrimaryButton}" Clicked="OnNewCollection" />
                <Button Text="Panele Dön" Style="{StaticResource SecondaryButton}" Clicked="OnBackToPanel" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
