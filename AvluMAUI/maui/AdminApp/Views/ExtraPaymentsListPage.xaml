<?xml version="1.0" encoding="utf-8" ?>
<!-- AdminApp · ExtraPaymentsListPage -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Avlu.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Avlu.AdminApp.Views.ExtraPaymentsListPage"
             Title="Ek Ödemeler">
    <Grid Padding="20,20,20,0" RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="2 aktif" Style="{StaticResource Caption}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="+" FontSize="18" WidthRequest="34" HeightRequest="34" Padding="0" CornerRadius="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Accent}}"
                    TextColor="{AppThemeBinding Light=White, Dark={StaticResource NavyDeep}}" Clicked="OnAddTapped" />
        </Grid>
        <controls:DataStateView Grid.Row="1" x:Name="StateHost" CurrentState="Content"
                                 EmptyTitle="Ek ödeme yok"
                                 EmptySub="Asansör yenileme, cephe boyası gibi tek seferlik giderleri buradan mülklere paylaştırabilirsin.">
            <controls:DataStateView.ContentViewContent>
                <CollectionView x:Name="ExtraList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="16" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnItemTapped" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" FontFamily="{StaticResource FontInterSemi}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                        <Label Grid.Column="1" Text="{Binding CollectedDisplay}" FontFamily="{StaticResource FontInterSemi}" FontSize="12.5" TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Accent}}" />
                                    </Grid>
                                    <Label Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="12" />
                                    <controls:ProgressBarView Percent="{Binding CollectedPct}" HeightRequest="6" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </controls:DataStateView.ContentViewContent>
        </controls:DataStateView>
    </Grid>
</ContentPage>
