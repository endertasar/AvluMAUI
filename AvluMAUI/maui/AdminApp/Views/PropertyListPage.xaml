<?xml version="1.0" encoding="utf-8" ?>
<!--
  AdminApp · PropertyListPage (Mülkler)
  Arama + filtre chip'leri + mülk listesi. DataStateView: Loading/Empty/Error/Content.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Avlu.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Avlu.AdminApp.Views.PropertyListPage"
             Title="Mülkler">

    <Grid Padding="20,54,20,0" RowDefinitions="Auto,Auto,*" RowSpacing="14">

        <Label Grid.Row="0" Text="42 mülk" Style="{StaticResource Caption}" Margin="0,0,0,-4" />

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Border Padding="14,0" HeightRequest="44" StrokeThickness="1.5"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha04}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource WhiteAlpha12}}">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Entry Placeholder="Blok, daire no veya isim ara" VerticalOptions="Center"
                       TextChanged="OnSearchChanged"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            </Border>
            <CollectionView ItemsSource="{Binding Filters}" SelectionMode="Single" HeightRequest="40"
                             ItemsLayout="HorizontalList" SelectionChanged="OnFilterChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="13,7" Margin="0,0,8,0" StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha06}}"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource WhiteAlpha12}}">
                            <Border.StrokeShape><shapes:RoundRectangle CornerRadius="999" /></Border.StrokeShape>
                            <Label Text="{Binding}" FontFamily="{StaticResource FontInterSemi}" FontSize="12.5"
                                   TextColor="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <controls:DataStateView Grid.Row="2" x:Name="StateHost" CurrentState="Content"
                                 EmptyTitle="Mülk bulunamadı"
                                 EmptySub="Arama kriterlerine uygun mülk yok. Filtreleri temizlemeyi dene."
                                 ErrorMessage="Mülk listesi yüklenemedi.">
            <controls:DataStateView.ContentViewContent>
                <CollectionView x:Name="PropertiesList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Model: BlockUnit, TypeLabel, Owner, DebtDisplay, HasDebt -->
                            <Border Margin="0,0,0,8" Padding="14" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPropertyTapped" CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
                                    <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource LineSoft}, Dark={StaticResource WhiteAlpha06}}">
                                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                        <Label Text="{Binding BlockUnit}" FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding TitleLine}" FontFamily="{StaticResource FontInterSemi}" FontSize="13.5"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                            <controls:Badge Text="{Binding TypeLabel}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Owner}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding DebtDisplay}" FontFamily="{StaticResource FontInterSemi}" FontSize="13.5"
                                           VerticalOptions="Center" TextColor="{StaticResource Danger}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </controls:DataStateView.ContentViewContent>
        </controls:DataStateView>
    </Grid>
</ContentPage>
