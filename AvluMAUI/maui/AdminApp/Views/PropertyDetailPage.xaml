<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Avlu.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Avlu.AdminApp.Views.PropertyDetailPage"
             Title="Mülk Detay">
    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,28" Spacing="0">

            <HorizontalStackLayout Spacing="10" Margin="0,0,0,20">
                <Label x:Name="PropertyTitleLabel"
                       Text="—"
                       FontFamily="{StaticResource FontInterSemi}" FontSize="15"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                <controls:Badge x:Name="PropertyTypeBadge" Text="—" />
            </HorizontalStackLayout>

            <Border Padding="16" Margin="0,0,0,18" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FBEAE9, Dark=#1AB3261E}">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="TOPLAM BORÇ" FontFamily="{StaticResource FontInterSemi}" FontSize="11.5" TextColor="{StaticResource Danger}" />
                    <Label x:Name="TotalDebtLabel"
                           Text="—"
                           FontFamily="{StaticResource FontInterSemi}" FontSize="26" TextColor="{StaticResource Danger}" />
                    <Button Text="Tahsilat Al" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Clicked="OnCollectTapped" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Sahip &amp; Oturan" FontFamily="{StaticResource FontInterSemi}" FontSize="13" Margin="0,0,0,10"
                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            <Border Padding="16,4" Margin="0,0,0,20" StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <Label Text="Sahip" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" x:Name="OwnerNameLabel" Text="—"
                               FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <Label Text="Sahip Telefon" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" x:Name="OwnerPhoneLabel" Text="—"
                               FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                        <Label Text="Aidat Sorumlusu" Style="{StaticResource Caption}" />
                        <Label Grid.Column="1" x:Name="DuesResponsibleLabel" Text="—"
                               FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <Label Text="Borç Listesi" FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                <Label Grid.Column="1" Text="Tümü" Style="{StaticResource Link}" />
            </Grid>
            <CollectionView x:Name="ChargesList" Margin="0,0,0,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- ChargeItem: Title, RemainingDisplay, StatusLabel -->
                        <Border Padding="14,12" Margin="0,0,0,8" StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                            <Border.StrokeShape><shapes:RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Title}"
                                       FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                <Label Grid.Column="1" Text="{Binding RemainingDisplay}"
                                       FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                <controls:StatusPill Grid.Column="2" StatusValue="{Binding Status}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Açık borç yok." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>

            <Label Text="Kredi Bakiyesi" FontFamily="{StaticResource FontInterSemi}" FontSize="13" Margin="0,0,0,10"
                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            <Border Padding="14,12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E3F2E9, Dark=#1A2E7D57}">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Kullanılabilir Kredi" FontFamily="{StaticResource FontInterSemi}" FontSize="13"
                           TextColor="{StaticResource Success}" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="CreditBalanceLabel" Text="0,00 ₺"
                           FontFamily="{StaticResource FontInterSemi}" FontSize="14"
                           TextColor="{StaticResource Success}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
