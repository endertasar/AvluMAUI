<?xml version="1.0" encoding="utf-8" ?>
<!-- ResidentApp · ResidentSignupPage — Kayıt Ol (Login zaten var) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Avlu.ResidentApp.Views.ResidentSignupPage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="24,54,24,28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">
            <HorizontalStackLayout Grid.Row="0" Spacing="14" Margin="0,0,0,28">
                <Border WidthRequest="36" HeightRequest="36" Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha08}}"
                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" StrokeThickness="1">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                    <Label Text="‹" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                </Border>
                <Label Text="Hesap oluştur" FontFamily="{StaticResource FontInterSemi}" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,22">
                <Label Style="{StaticResource H2}" Text="Avlu ailesine katıl" />
                <Label Style="{StaticResource Body}" FontSize="14" Text="Sakin olarak birkaç bilgiyle hesabını oluşturalım." />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="AD SOYAD" />
                    <Border Style="{StaticResource FieldBorder}"><Entry Style="{StaticResource FieldEntry}" Text="Zeynep Arslan" /></Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="TELEFON NUMARASI" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="+90" FontFamily="{StaticResource FontInterSemi}" FontSize="15" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}" />
                            <Entry Grid.Column="1" Style="{StaticResource FieldEntry}" Keyboard="Telephone" Text="555 987 65 43" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="ŞİFRE" />
                    <Border Style="{StaticResource FieldBorder}"><Entry Style="{StaticResource FieldEntry}" IsPassword="True" Text="••••••••" /></Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="3" Spacing="12">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox Color="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Accent}}" />
                    <Label Text="Kullanım Şartları ve KVKK metnini kabul ediyorum." Style="{StaticResource Caption}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Text="Devam Et" Style="{StaticResource PrimaryButton}" Clicked="OnContinueTapped" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
