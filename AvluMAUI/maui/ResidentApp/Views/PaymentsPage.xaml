<?xml version="1.0" encoding="utf-8" ?>
<!-- ResidentApp · PaymentsPage — Ödemelerim -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Avlu.Controls"
             x:Class="Avlu.ResidentApp.Views.PaymentsPage"
             Title="Ödemelerim">
    <controls:DataStateView x:Name="StateHost" CurrentState="Content" EmptyTitle="Henüz ödeme yok" EmptySub="Ödemeleriniz burada listelenecek.">
        <controls:DataStateView.ContentViewContent>
            <CollectionView x:Name="GroupedList" Margin="20,20,20,28">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}" />
                </CollectionView.ItemsSource>
            </CollectionView>
        </controls:DataStateView.ContentViewContent>
    </controls:DataStateView>
</ContentPage>
