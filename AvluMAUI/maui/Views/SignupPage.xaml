<?xml version="1.0" encoding="utf-8" ?>
<!--
  Avlu · SignupPage
  Geri butonu, başlık, AD SOYAD / TELEFON / ŞİFRE + şifre gücü barı,
  KVKK onayı, Devam Et butonu.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Avlu.Views.SignupPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24,54,24,28" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="0">

            <!-- 0 · Header -->
            <HorizontalStackLayout Grid.Row="0" Spacing="14" Margin="0,0,0,28" VerticalOptions="Center">
                <Border WidthRequest="36" HeightRequest="36" Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha08}}"
                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="‹" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                </Border>
                <Label Text="Hesap oluştur"
                       FontFamily="{StaticResource FontInterSemi}" FontSize="15"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            </HorizontalStackLayout>

            <!-- 1 · Başlık -->
            <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,22">
                <Label Style="{StaticResource H2}" Text="Avlu ailesine katıl" />
                <Label Style="{StaticResource Body}" FontSize="14" Text="Birkaç bilgiyle hesabını oluşturalım." />
            </VerticalStackLayout>

            <!-- 2 · Form -->
            <VerticalStackLayout Grid.Row="2" Spacing="12">
                <!-- Ad Soyad -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="AD SOYAD" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Style="{StaticResource FieldEntry}" Placeholder="Ayşe Yıldız" />
                    </Border>
                </VerticalStackLayout>

                <!-- Telefon -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="TELEFON NUMARASI" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="+90"
                                   FontFamily="{StaticResource FontInterSemi}" FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1" Style="{StaticResource FieldEntry}"
                                   Keyboard="Telephone" Placeholder="555 123 45 67" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Şifre -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="ŞİFRE" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Style="{StaticResource FieldEntry}" IsPassword="True" Placeholder="••••••••" />
                    </Border>
                </VerticalStackLayout>

                <!-- Şifre gücü -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Grid Grid.Column="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="3" VerticalOptions="Center">
                        <BoxView Grid.Column="0" HeightRequest="3" CornerRadius="2" Color="{StaticResource Success}" />
                        <BoxView Grid.Column="1" HeightRequest="3" CornerRadius="2" Color="{StaticResource Success}" />
                        <BoxView Grid.Column="2" HeightRequest="3" CornerRadius="2" Color="{StaticResource Accent}" />
                        <BoxView Grid.Column="3" HeightRequest="3" CornerRadius="2"
                                 Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
                    </Grid>
                    <Label Grid.Column="1" Text="Orta" FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- 3 · Spacer -->
            <BoxView Grid.Row="3" HeightRequest="14" Color="Transparent" />

            <!-- 4 · KVKK -->
            <HorizontalStackLayout Grid.Row="4" Spacing="8" Margin="0,0,0,12" VerticalOptions="Center">
                <CheckBox Color="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Accent}}" />
                <Label Style="{StaticResource Caption}" VerticalOptions="Center"
                       Text="Kullanım Şartları ve KVKK metnini okudum, kabul ediyorum." />
            </HorizontalStackLayout>

            <!-- 5 · CTA -->
            <Button Grid.Row="5" Style="{StaticResource PrimaryButton}" Text="Devam Et" Clicked="OnContinueTapped" />
        </Grid>
    </ScrollView>
</ContentPage>
