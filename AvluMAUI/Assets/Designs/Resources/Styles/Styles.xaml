<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Avlu · Global Styles
  Tipografi ölçüleri ve ortak stiller. Tasarımdaki ölçüler birebir korundu.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Varsayılan font ailesi (MauiProgram.cs'te AddFont ile kayıtlı) -->
    <x:String x:Key="FontInter">Inter</x:String>
    <x:String x:Key="FontInterSemi">InterSemiBold</x:String>

    <!-- Type scale (tasarımdaki px değerleri) -->
    <x:Double x:Key="FontSize11">11</x:Double>
    <x:Double x:Key="FontSize12">12</x:Double>
    <x:Double x:Key="FontSize13">13</x:Double>
    <x:Double x:Key="FontSize14">14</x:Double>
    <x:Double x:Key="FontSize15">15</x:Double>
    <x:Double x:Key="FontSize16">16</x:Double>
    <x:Double x:Key="FontSize18">18</x:Double>
    <x:Double x:Key="FontSize26">26</x:Double>
    <x:Double x:Key="FontSize28">28</x:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="Radius10">10</CornerRadius>
    <CornerRadius x:Key="Radius12">12</CornerRadius>
    <CornerRadius x:Key="Radius14">14</CornerRadius>
    <CornerRadius x:Key="Radius16">16</CornerRadius>
    <CornerRadius x:Key="Radius999">999</CornerRadius>

    <!-- ContentPage: varsayılan arka plan -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Bg}, Dark={StaticResource BgDark}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Başlık (Merhaba, komşu 👋) -->
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.15" />
        <Setter Property="CharacterSpacing" Value="-0.6" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Ara başlık -->
    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="1.15" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Body -->
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}" />
    </Style>

    <!-- Küçük yardımcı metin -->
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}" />
    </Style>

    <!-- Label for input (TELEFON NUMARASI vb.) -->
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}" />
    </Style>

    <!-- Link (Şifremi unuttum vb.) -->
    <Style x:Key="Link" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontInterSemi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource Accent}}" />
    </Style>

    <!-- KVKK / alt bilgi -->
    <Style x:Key="Legal" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontInter}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}" />
    </Style>

</ResourceDictionary>
