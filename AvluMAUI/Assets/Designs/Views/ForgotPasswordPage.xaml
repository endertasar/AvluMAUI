<?xml version="1.0" encoding="utf-8" ?>
<!--
  Avlu · ForgotPasswordPage
  Geri, kilit ikonu, başlık/açıklama, telefon alanı, Kod Gönder + Girişe Dön.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Avlu.Views.ForgotPasswordPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24,54,24,28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="0">

            <!-- 0 · Back -->
            <Border Grid.Row="0" WidthRequest="36" HeightRequest="36" Padding="0"
                    HorizontalOptions="Start" Margin="0,0,0,28"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha08}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="‹" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            </Border>

            <!-- 1 · İkon rozeti (kilit) -->
            <Border Grid.Row="1" WidthRequest="64" HeightRequest="64" Padding="0"
                    HorizontalOptions="Start" Margin="0,0,0,22"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark=#24C8A15A}"
                    StrokeThickness="0">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Label Text="🔒" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- 2 · Başlık -->
            <Label Grid.Row="2" Style="{StaticResource H2}" Text="Şifreni mi unuttun?" />

            <!-- 3 · Açıklama -->
            <Label Grid.Row="3" Style="{StaticResource Body}" FontSize="14" Margin="0,8,0,28"
                   Text="Telefonuna doğrulama kodu göndereceğiz. Kodu girdikten sonra yeni şifreni belirleyebilirsin." />

            <!-- 4 · Telefon alanı -->
            <VerticalStackLayout Grid.Row="4" Spacing="6">
                <Label Style="{StaticResource FieldLabel}" Text="TELEFON NUMARASI" />
                <Border Style="{StaticResource FieldBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="+90"
                               FontFamily="{StaticResource FontInterSemi}" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1" Style="{StaticResource FieldEntry}"
                               Keyboard="Telephone" Placeholder="555 123 45 67" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- 5 · Spacer -->
            <BoxView Grid.Row="5" Color="Transparent" />

            <!-- 6 · CTA'lar -->
            <VerticalStackLayout Grid.Row="6" Spacing="10">
                <Button Style="{StaticResource PrimaryButton}" Text="Kod Gönder" Clicked="OnSendCode" />
                <Button Style="{StaticResource GhostButton}" Text="Girişe Dön" Clicked="OnBackTapped" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
