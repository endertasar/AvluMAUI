<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AvluMAUI.ViewModels.Properties"
             xmlns:models="clr-namespace:AvluMAUI.Models.Property"
             x:Class="AvluMAUI.Views.Properties.PropertyListPage"
             x:DataType="vm:PropertyListViewModel"
             Title="Mülkler">

    <Grid RowDefinitions="Auto,*">

        <!-- Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource FieldBorder}" Margin="16,12">
            <Entry Placeholder="Daire ara..."
                   Text="{Binding SearchText}"
                   Style="{StaticResource FieldEntry}"/>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Properties}"
                        Margin="16,0,16,16">
            <CollectionView.Header>
                <Button Text="+ Yeni Daire"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,0,12"/>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PropertyDto">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding DisplayName}"
                                       Style="{StaticResource Body}"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding ResidentName}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding TypeLabel}"
                                   Style="{StaticResource Caption}"
                                   TextColor="{StaticResource NavyLight}"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PropertyListViewModel}}, Path=OpenDetailCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Henüz daire yok." Style="{StaticResource Body}"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center" Margin="0,40"/>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
