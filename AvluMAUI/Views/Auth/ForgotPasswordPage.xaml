<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AvluMAUI.ViewModels.Auth"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="AvluMAUI.Views.Auth.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24,54,24,28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="0">

            <!-- 0 · Geri butonu -->
            <Border Grid.Row="0" WidthRequest="36" HeightRequest="36" Padding="0"
                    HorizontalOptions="Start" Margin="0,0,0,28"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource WhiteAlpha08}}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Border.GestureRecognizers>
                <Label Text="‹" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            </Border>

            <!-- 1 · İkon rozeti (kilit) -->
            <Border Grid.Row="1" WidthRequest="64" HeightRequest="64" Padding="0"
                    HorizontalOptions="Start" Margin="0,0,0,22"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark=#24C8A15A}"
                    StrokeThickness="0">
                <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Label Text="🔒" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- 2 · Başlık -->
            <Label Grid.Row="2" Style="{StaticResource H2}" Text="Şifreni mi unuttun?" />

            <!-- 3 · Açıklama -->
            <Label Grid.Row="3" Style="{StaticResource Body}" FontSize="14" Margin="0,8,0,28"
                   Text="Telefonuna doğrulama kodu göndereceğiz. Kodu girdikten sonra yeni şifreni belirleyebilirsin." />

            <!-- 4 · Form -->
            <VerticalStackLayout Grid.Row="4" Spacing="14">

                <!-- Hata mesajı -->
                <Border BackgroundColor="{StaticResource DangerLight}"
                        Stroke="{StaticResource Danger}"
                        StrokeThickness="1"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"
                        Padding="12,8">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           Style="{StaticResource Caption}" />
                </Border>

                <!-- Telefon numarası -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource FieldLabel}" Text="TELEFON NUMARASI" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="+90"
                                   FontFamily="{StaticResource FontInterSemi}" FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource Sub}, Dark={StaticResource SubDark}}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Style="{StaticResource FieldEntry}"
                                   Text="{Binding PhoneNumber}"
                                   Keyboard="Telephone"
                                   Placeholder="555 123 45 67"
                                   MaxLength="13"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding SendCodeCommand}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- 5 · Spacer -->
            <BoxView Grid.Row="5" Color="Transparent" />

            <!-- 6 · CTA'lar -->
            <VerticalStackLayout Grid.Row="6" Spacing="10">
                <Button Style="{StaticResource PrimaryButton}" Text="Kod Gönder"
                        Command="{Binding SendCodeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Navy}"
                                   HorizontalOptions="Center" />

                <Button Style="{StaticResource GhostButton}" Text="Girişe Dön"
                        Command="{Binding BackCommand}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
