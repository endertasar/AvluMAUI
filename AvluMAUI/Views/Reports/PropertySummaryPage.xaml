<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AvluMAUI.ViewModels.Reports"
             xmlns:models="clr-namespace:AvluMAUI.Models.Report"
             x:Class="AvluMAUI.Views.Reports.PropertySummaryPage"
             x:DataType="vm:PropertySummaryViewModel"
             Title="Daire Özeti">

    <CollectionView ItemsSource="{Binding Items}" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:PropertySummaryDto">
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding DisplayName}" Style="{StaticResource Body}" FontAttributes="Bold"/>
                            <Label Style="{StaticResource Caption}" TextColor="{StaticResource TextMuted}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Ödenen: "/>
                                        <Span Text="{Binding TotalPaid, Converter={StaticResource AmountToString}}"
                                              TextColor="{StaticResource Success}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                            <Label Text="{Binding TotalDebt, Converter={StaticResource AmountToString}}"
                                   Style="{StaticResource Caption}"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalOptions="End"/>
                            <Label Text="{Binding Balance, Converter={StaticResource AmountToString}}"
                                   Style="{StaticResource Body}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Danger}"
                                   HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <Label Text="Veri yok." Style="{StaticResource Body}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center" Margin="0,40"/>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
