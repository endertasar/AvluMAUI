<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AvluMAUI.ViewModels.Payments"
             xmlns:models="clr-namespace:AvluMAUI.Models.Payment"
             x:Class="AvluMAUI.Views.Payments.PaymentListPage"
             x:DataType="vm:PaymentListViewModel"
             Title="Ödemeler">

    <CollectionView ItemsSource="{Binding Payments}" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:PaymentDto">
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding PaidAt, StringFormat='{0:dd.MM.yyyy}'}"
                                   Style="{StaticResource Body}" FontAttributes="Bold"/>
                            <Label Text="{Binding MethodLabel}"
                                   Style="{StaticResource Caption}"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Amount, Converter={StaticResource AmountToString}}"
                               Style="{StaticResource Body}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Success}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <Label Text="Henüz ödeme yok." Style="{StaticResource Body}"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center" Margin="0,40"/>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>
